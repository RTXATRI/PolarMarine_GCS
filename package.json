{
  "name": "polarmarine-gcs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first multi-agent PolarMarine ground control station",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/e2e/run-playwright.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.{vue,scss,css}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript contracts/openapi/polarmarine-gcs-v1.json -o src/shared/api/generated.ts",
    "check": "npm run type-check && npm run lint && npm run lint:styles && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "maplibre-gl": "^6.0.0",
    "pinia": "^2.2.2",
    "pmtiles": "^4.4.1",
    "vue": "^3.5.40",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "sass": "^1.101.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
